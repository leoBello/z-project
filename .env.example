# Identifiants du projet Firebase, pour le classement des défis.
#
# À copier en `.env` (qui n'est pas versionné). Sans ces variables, le jeu est
# complet et le classement n'apparaît nulle part : rien ne casse, rien n'est
# signalé au joueur.
#
# Ces identifiants sont publics par construction — ils partent dans le bundle et
# désignent le projet sans l'autoriser. Ce sont les règles de sécurité qui
# autorisent, et elles sont dans `firestore.rules`.
#
# Où les trouver : console Firebase > Paramètres du projet > Vos applications.
# Seuls les deux premiers sont nécessaires au classement. `MEASUREMENT_ID` sert
# à la mesure d'audience Google (voir plus bas) ; les autres désignent des
# services que le jeu n'utilise pas et peuvent rester vides.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Mesure d'audience. Deux collecteurs facultatifs et indépendants, qui reçoivent
# les mêmes événements : Umami et Google Analytics 4. Aucun des deux ne pose de
# cookie. Voir `plugins/analytics.ts` et la section « Mesure d'audience » du
# README — notamment les paramètres à déclarer dans GA4, sans quoi ils ne
# s'affichent nulle part.
VITE_UMAMI_WEBSITE_ID=

# Identifiant du flux GA4 (`G-…`). Inutile de le renseigner si la propriété a
# été créée depuis Firebase : `VITE_FIREBASE_MEASUREMENT_ID` ci-dessus porte le
# même identifiant et sert de repli.
VITE_GA_MEASUREMENT_ID=

# Identifiants du projet Firebase, pour le classement des défis.
#
# À copier en `.env` (qui n'est pas versionné). Sans ces variables, le jeu est
# complet et le classement n'apparaît nulle part : rien ne casse, rien n'est
# signalé au joueur.
#
# Ces identifiants sont publics par construction — ils partent dans le bundle et
# désignent le projet sans l'autoriser. Ce sont les règles de sécurité qui
# autorisent, et elles sont dans `firestore.rules`.
#
# Où les trouver : console Firebase > Paramètres du projet > Vos applications.
# Seuls les deux premiers sont nécessaires au classement ; les autres servent à
# des services que le jeu n'utilise pas et peuvent rester vides.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Mesure d'audience Umami. Voir `plugins/analytics.ts`.
VITE_UMAMI_WEBSITE_ID=
